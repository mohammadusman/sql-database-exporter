# Copy this file to .env and enter real values. Never commit .env.
# SQL_DATABASE supports the exact tokens {client} and {profile}.
SQL_SERVER=sql-server.example.com
SQL_DATABASE={client}
SQL_AUTHENTICATION=Sql
SQL_USER=export_user
SQL_PASSWORD=replace_me

# Set these according to your SQL Server TLS configuration.
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=false

# Optional tuning.
EXPORT_ROOT=./exports
EXPORT_PARALLELISM=4
SQL_CONNECTION_TIMEOUT_SECONDS=30
SQL_COMMAND_TIMEOUT_SECONDS=0
